{
  "name": "detox-extension",
  "private": true,
  "version": "2.0.1",
  "type": "module",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js",
    "dev:full": "cross-env VITE_BUILD_PROFILE=full node node_modules/vite/bin/vite.js",
    "dev:firefox": "node node_modules/vite/bin/vite.js --config vite.config.firefox.ts",
    "dev:firefox:full": "cross-env VITE_BUILD_PROFILE=full node node_modules/vite/bin/vite.js --config vite.config.firefox.ts",
    "fetch:modelpack": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/fetch-model-pack.ps1",
    "prepare:ort": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/fetch-ort-wasm.ps1",
    "build:core": "node node_modules/typescript/bin/tsc -b && node node_modules/vite/bin/vite.js build",
    "build:full": "pnpm prepare:ort && node node_modules/typescript/bin/tsc -b && cross-env VITE_BUILD_PROFILE=full node node_modules/vite/bin/vite.js build",
    "build": "pnpm build:core",
    "build:core:firefox": "node node_modules/typescript/bin/tsc -b && node node_modules/vite/bin/vite.js build --config vite.config.firefox.ts",
    "build:full:firefox": "pnpm prepare:ort && node node_modules/typescript/bin/tsc -b && cross-env VITE_BUILD_PROFILE=full node node_modules/vite/bin/vite.js build --config vite.config.firefox.ts",
    "build:firefox": "pnpm build:core:firefox",
    "lint": "node node_modules/eslint/bin/eslint.js .",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "test:e2e": "node node_modules/@playwright/test/cli.js test",
    "test:perf": "node node_modules/@playwright/test/cli.js test tests/perf-regression.spec.ts"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "onnxruntime-web": "^1.14.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.0.0-beta.33",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.1",
    "@types/chrome": "^0.1.36",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.5.0"
  }
}