{
  "name": "detox-extension",
  "private": true,
  "version": "2.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:firefox": "vite --config vite.config.firefox.ts",
    "fetch:modelpack": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/fetch-model-pack.ps1",
    "prepare:ort": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/fetch-ort-wasm.ps1",
    "build": "pnpm prepare:ort && tsc -b && vite build",
    "build:firefox": "pnpm prepare:ort && tsc -b && vite build --config vite.config.firefox.ts",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:perf": "playwright test tests/perf-regression.spec.ts"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "onnxruntime-web": "^1.14.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.0.0-beta.33",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.1",
    "@types/chrome": "^0.1.36",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.5.0"
  }
}