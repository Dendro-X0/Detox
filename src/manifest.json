{
  "manifest_version": 3,
  "name": "SignalLens",
  "version": "2.0.0.1",
  "version_name": "2.0.0-beta.1",
  "description": "Personal browsing layer for focus-first web reading.",
  "permissions": [
    "activeTab",
    "contextMenus",
    "offscreen",
    "scripting",
    "sidePanel",
    "storage"
  ],
  "host_permissions": [
    "https://huggingface.co/*",
    "https://*.huggingface.co/*",
    "https://hf.co/*",
    "https://*.hf.co/*",
    "https://en.wikipedia.org/*",
    "https://api.search.brave.com/*",
    "<all_urls>"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_popup": "index.html"
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "src/content.ts"
      ],
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*",
        "model-packs/*",
        "model-packs/**/*",
        "*.wasm"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' https://huggingface.co https://*.huggingface.co https://hf.co https://*.hf.co https://en.wikipedia.org https://api.search.brave.com https: http:"
  }
}